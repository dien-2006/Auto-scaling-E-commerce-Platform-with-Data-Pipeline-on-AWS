# Fill real values in backend-secret.env (DO NOT COMMIT it).
# Names must match your backend code's environment variable names.
MARKETPLACE_DB_HOST=RDS_PRIVATE_HOST
MARKETPLACE_DB_PORT=5432
MARKETPLACE_DB_NAME=coco_marketplace
MARKETPLACE_DB_USER=coco_admin
MARKETPLACE_DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD
MARKETPLACE_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MARKETPLACE_PROXY_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MARKETPLACE_OTP_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MARKETPLACE_SMTP_HOST=REPLACE_WITH_SMTP_HOST
MARKETPLACE_SMTP_PORT=587
MARKETPLACE_SMTP_SECURITY=STARTTLS
MARKETPLACE_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
MARKETPLACE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MARKETPLACE_OTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER

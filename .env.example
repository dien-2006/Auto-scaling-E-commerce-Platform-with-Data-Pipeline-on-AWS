# Single private runtime config. Copy only on a NEW machine, never over an existing .env.
# Commit this template; never commit .env or exported Docker archives.
COCO_IMAGE_TAG=2026.11.18
POSTGRES_VERSION=16
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_START
POSTGRES_PORT=5432
TZ=Asia/Ho_Chi_Minh
FRONTEND_PORT=3001
BACKEND_PORT=8000

# Use your exact URL; add actual LAN/domain origins when needed.
MARKETPLACE_ENVIRONMENT=local
MARKETPLACE_PUBLIC_ORIGIN=http://localhost:3001
MARKETPLACE_ADDITIONAL_ORIGINS='["http://localhost:3001"]'
MARKETPLACE_LOG_LEVEL=INFO
# Generate a random secret of at least 32 characters before enabling authentication.
# MARKETPLACE_JWT_SECRET=
MARKETPLACE_JWT_ISSUER=marketplace
MARKETPLACE_JWT_AUDIENCE=marketplace-web
MARKETPLACE_DB_POOL_SIZE=5
MARKETPLACE_DB_MAX_OVERFLOW=5

# Existing 25-table schema without checkout-options proposal.
MARKETPLACE_LEGACY_SCHEMA=true
MARKETPLACE_CHECKOUT_OPTIONS_ENABLED=false
MARKETPLACE_SHIPPING_STANDARD_FEE=25000
MARKETPLACE_SHIPPING_EXPRESS_FEE=40000
MARKETPLACE_SHIPPING_COCOEXPRESS_FEE=60000
# MARKETPLACE_BANK_NAME=
# MARKETPLACE_BANK_ACCOUNT_NUMBER=
# MARKETPLACE_BANK_ACCOUNT_HOLDER=

# S3: configure locally or use IAM role credentials in AWS.
# MARKETPLACE_S3_BUCKET=
MARKETPLACE_S3_REGION=us-east-1
MARKETPLACE_S3_PATH_STYLE=false
# MARKETPLACE_S3_ENDPOINT_URL=
# MARKETPLACE_S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Brevo SMTP. OTP stays disabled until sender, credentials and Redis are ready.
MARKETPLACE_OTP_ENABLED=false
# MARKETPLACE_OTP_SECRET=
MARKETPLACE_OTP_REDIS_URL=redis://otp-redis:6379/0
MARKETPLACE_OTP_EMAIL_PROVIDER=smtp
# MARKETPLACE_OTP_FROM_EMAIL=
MARKETPLACE_SMTP_HOST=smtp-relay.brevo.com
MARKETPLACE_SMTP_PORT=587
MARKETPLACE_SMTP_SECURITY=STARTTLS
# MARKETPLACE_SMTP_USERNAME=
# MARKETPLACE_SMTP_PASSWORD=

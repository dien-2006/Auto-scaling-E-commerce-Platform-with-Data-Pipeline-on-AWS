# Copy to .env and replace placeholders; credentials use the normal boto3 chain.
COCO_ENV=dev
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_ACCOUNT_ID
# Optional local AWS profile. Leave empty to use environment/role credentials.
AWS_PROFILE=

# Match the outputs of terraform/environments/dev (change all dev values for prod).
ETL_BUCKET=ecommerce-dev-data-lake-REPLACE_WITH_12_DIGIT_ACCOUNT_ID-ap-southeast-1
GLUE_EXTRACT_JOB=ecommerce-dev-extract
GLUE_TRANSFORM_JOB=ecommerce-dev-transform
GLUE_WORKFLOW=ecommerce-dev-pipeline
ATHENA_DATABASE=ecommerce_dev_analytics
ATHENA_WORKGROUP=ecommerce-dev-analytics
# UTC: 01:00 = 08:00 Asia/Saigon; inactive until --enable-schedule is requested.
GLUE_SCHEDULE=cron(0 1 * * ? *)


set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Retry transient network and package-manager failures during first boot.
retry() {
  local attempt
  for attempt in $(seq 1 12); do
    if "$@"; then return 0; fi
    sleep 10
  done
  return 1
}

swapoff -a
sed -i '/ swap / s/^/#/' /etc/fstab
cat >/etc/modules-load.d/k8s.conf <<'EOF'
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter
cat >/etc/sysctl.d/99-kubernetes.conf <<'EOF'
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOF
sysctl --system
retry apt-get update
retry apt-get install -y ca-certificates curl gnupg unzip containerd

# Ubuntu 24.04 repositories may not provide awscli. Use the official AWS installer.
if [[ "$(aws --version 2>&1 || true)" != aws-cli/2.* ]]; then
  case "$(uname -m)" in
    x86_64) aws_cli_arch=x86_64 ;;
    aarch64) aws_cli_arch=aarch64 ;;
    *) echo "Unsupported AWS CLI architecture" >&2; exit 1 ;;
  esac
  aws_cli_directory=$(mktemp -d /tmp/coco-awscli.XXXXXX)
  retry curl -fsSL --retry 5 \
    "https://awscli.amazonaws.com/awscli-exe-linux-$aws_cli_arch.zip" \
    -o "$aws_cli_directory/awscliv2.zip"
  unzip -q "$aws_cli_directory/awscliv2.zip" -d "$aws_cli_directory"
  "$aws_cli_directory/aws/install" --update
fi
aws --version
mkdir -p /etc/containerd
containerd config default > /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
systemctl enable --now containerd
systemctl restart containerd
install -m 0755 -d /etc/apt/keyrings
retry curl -fsSL --retry 5 https://pkgs.k8s.io/core:/stable:/v${kubernetes_minor_version}/deb/Release.key -o /tmp/kubernetes.key
gpg --dearmor --yes -o /etc/apt/keyrings/kubernetes.gpg /tmp/kubernetes.key
echo 'deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v${kubernetes_minor_version}/deb/ /' > /etc/apt/sources.list.d/kubernetes.list
retry apt-get update
retry apt-get install -y kubelet kubeadm kubectl
apt-mark hold kubelet kubeadm kubectl
systemctl enable kubelet

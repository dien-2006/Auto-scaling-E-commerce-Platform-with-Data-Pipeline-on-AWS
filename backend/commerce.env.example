# LEGACY REFERENCE ONLY: use the repository root .env.example -> .env.
# Compose no longer reads service-specific private env files.
# Copy to backend/.env.commerce locally; never put real secrets in this template.
# Enable only AFTER the approved 20261115_checkout_options.sql schema update.
MARKETPLACE_CHECKOUT_OPTIONS_ENABLED=false
# Fixed VND per shop; user authorized COCO to set these rates.
MARKETPLACE_SHIPPING_STANDARD_FEE=25000
MARKETPLACE_SHIPPING_EXPRESS_FEE=40000
MARKETPLACE_SHIPPING_COCOEXPRESS_FEE=60000
# Uncomment all three after providing real recipient details locally.
# MARKETPLACE_BANK_NAME=
# MARKETPLACE_BANK_ACCOUNT_NUMBER=
# MARKETPLACE_BANK_ACCOUNT_HOLDER=
# BANK_TRANSFER creates PENDING payments; it does not auto-confirm receipt.
# MOMO / VNPAY remain disabled: merchant integration and verified callbacks not implemented.

# LEGACY REFERENCE ONLY: use the repository root .env.example -> .env.
# Compose no longer reads service-specific private env files.
# Email OTP via Brevo SMTP. Keep private credentials only in backend/.env.otp.
# Existing 25 PostgreSQL tables/constraints stay unchanged. No SQL to run.
MARKETPLACE_OTP_ENABLED=false
# Keep the generated dedicated OTP secret; never share or reuse the JWT secret.
# MARKETPLACE_OTP_SECRET=
# Compose overlay: private shared cache, no host port. Local Python needs its own Redis URL.
MARKETPLACE_OTP_REDIS_URL=redis://otp-redis:6379/0
MARKETPLACE_OTP_EMAIL_PROVIDER=smtp
# Verified sender email from Brevo, not necessarily the SMTP login.
# MARKETPLACE_OTP_FROM_EMAIL=
MARKETPLACE_SMTP_HOST=smtp-relay.brevo.com
MARKETPLACE_SMTP_PORT=587
MARKETPLACE_SMTP_SECURITY=STARTTLS
# Copy SMTP login and SMTP key from Brevo > SMTP & API > SMTP.
# An SMTP key is different from an API key or your Brevo account password.
# MARKETPLACE_SMTP_USERNAME=
# MARKETPLACE_SMTP_PASSWORD=

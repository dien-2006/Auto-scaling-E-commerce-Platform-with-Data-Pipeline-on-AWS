# LEGACY REFERENCE ONLY: use the repository root .env.example -> .env.
# Compose no longer reads service-specific private env files.
# For direct local backend execution only; Compose supplies these from existing root .env.
MARKETPLACE_ENVIRONMENT=local
MARKETPLACE_LOG_LEVEL=INFO
MARKETPLACE_DB_HOST=127.0.0.1
MARKETPLACE_DB_PORT=5432
MARKETPLACE_DB_NAME=marketplace_db
MARKETPLACE_DB_USER=marketplace_user
MARKETPLACE_DB_PASSWORD=replace_with_your_existing_database_password
MARKETPLACE_DB_POOL_SIZE=5
MARKETPLACE_DB_MAX_OVERFLOW=5
# In Docker the hostname is postgres, injected by Compose, never 127.0.0.1.

# Generate a random secret locally; never commit the real value.
MARKETPLACE_PUBLIC_ORIGIN=http://localhost:3001
MARKETPLACE_JWT_SECRET=
MARKETPLACE_JWT_ISSUER=marketplace
MARKETPLACE_JWT_AUDIENCE=marketplace-web

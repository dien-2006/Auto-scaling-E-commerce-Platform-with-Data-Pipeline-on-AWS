# LEGACY REFERENCE ONLY: use the repository root .env.example -> .env.
# Compose no longer reads service-specific private env files.
# Copy to backend/.env.storage only when a bucket is available. Backend only.
MARKETPLACE_S3_BUCKET=
MARKETPLACE_S3_REGION=ap-southeast-1
# Empty endpoint uses AWS S3. Custom endpoint must be HTTPS and browser-reachable.
MARKETPLACE_S3_ENDPOINT_URL=
MARKETPLACE_S3_PATH_STYLE=false
# Optional HTTPS CDN base, serving only verified product-images/ objects.
# Empty base uses private, 15-minute presigned GET delivery URLs.
MARKETPLACE_S3_PUBLIC_BASE_URL=
# Prefer an IAM workload role. For local credentials, configure these privately.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
